# Copy to terraform.tfvars (that file is git-ignored) and fill in your own values.
# Secrets can also be passed as environment variables: export TF_VAR_gemini_api_key="..."

render_api_key  = "rnd_..."
render_owner_id = "usr-..."

supabase_access_token    = "sbp_..."
supabase_publishable_key = "sb_publishable_..."

cloudflare_api_token  = "..."
cloudflare_account_id = "32 characters from Workers & Pages -> Account details"
cf_images_api_token   = "token with the Workers AI permission"

gemini_api_key = "..."

# Optional
# gemini_model         = "gemini-flash-lite-latest"
# sentry_dsn           = "https://...@o0.ingest.sentry.io/0"
# confirm_email        = true
# google_client_id     = "....apps.googleusercontent.com"
# google_client_secret = "..."
# smtp_host            = "smtp.gmail.com"
# smtp_user            = "mealoria.app@gmail.com"
# smtp_password        = "Gmail app password"
