{
  "name": "mealoria",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // serve .html files exactly as they are (Google's verification file must not be redirected)
    "html_handling": "none",
    // every request passes the Worker first, so http:// can be redirected to https://
    "run_worker_first": true
  },
  // keeps the free Render backend awake (see worker/index.js)
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
